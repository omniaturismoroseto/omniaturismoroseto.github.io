rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Il diario scrive da browser anonimo: diariogiornaliero.html e
    // admin-diario.html non autenticano. Resta cosi' finche' il diario non
    // confluisce nell'app postazioni.
    // Niente update ne' delete: lo storico non e' alterabile dall'esterno.
    match /diariogiornaliero/{doc} {
      allow read, create: if true;
    }
    // Contatti Telegram del diario. Da quando admin-diario.html chiede le
    // credenziali, qui entrano solo gli account dell'app segnalazioni con
    // ruolo admin o coordinator: niente piu' lettura anonima dei contatti.
    // La scrittura deve inoltre avere la forma esatta che usa la pagina:
    // nessun campo arbitrario, nessuna lista enorme. Il documento non e'
    // cancellabile e nessun altro documento puo' nascere dentro config.
    // Le Cloud Functions usano l'Admin SDK e ignorano queste regole.
    function autorizzato() {
      return request.auth != null
             && request.auth.token.role in ['admin', 'coordinator'];
    }
    match /config/telegram_diario {
      allow read: if autorizzato();
      allow write: if autorizzato()
                   && request.resource.data.keys().hasOnly(['chat_ids', 'updated'])
                   && request.resource.data.chat_ids is list
                   && request.resource.data.chat_ids.size() > 0
                   && request.resource.data.chat_ids.size() <= 20;
    }
    // Il modulo /candidature del sito scrive da browser anonimo.
    // Solo create, e solo con consenso privacy e campi di lunghezza
    // sensata: serve a non farsi riempire la collection di spazzatura.
    // Niente read dal web: le candidature si leggono dalla console e
    // dalla Cloud Function, che usa l'Admin SDK e ignora le regole.
    match /candidature/{doc} {
      allow create: if request.resource.data.privacy == true
                    && request.resource.data.stato == 'nuova'
                    && request.resource.data.nome is string
                    && request.resource.data.nome.size() > 1
                    && request.resource.data.nome.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() < 120
                    && request.resource.data.telefono is string
                    && request.resource.data.telefono.size() < 30
                    && request.resource.data.get('note', '').size() < 1500;
      allow read, update, delete: if false;
    }
    // Segnalazioni anonime del personale, dalla pagina
    // /segnalazioni-interne. hasOnly e' la parte importante: impedisce di
    // aggiungere al documento qualunque campo diverso da questi, quindi
    // nessuno puo' infilarci un identificativo e rompere l'anonimato
    // promesso dalla pagina. Niente lettura dal web: le segnalazioni si
    // leggono dalla console e dalla Cloud Function, che usa l'Admin SDK.
    match /segnalazioniInterne/{doc} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['categoria','urgenza','messaggio','dove','contatto','data','stato','origine'])
                    && request.resource.data.stato == 'nuova'
                    && request.resource.data.categoria is string
                    && request.resource.data.categoria.size() < 60
                    && request.resource.data.messaggio is string
                    && request.resource.data.messaggio.size() > 9
                    && request.resource.data.messaggio.size() <= 3500
                    && request.resource.data.data is string
                    && request.resource.data.data.size() == 10
                    && request.resource.data.get('dove', '').size() <= 100
                    && request.resource.data.get('contatto', '').size() <= 150;
      allow read, update, delete: if false;
    }
    match /meteoGiornaliero/{data} {
      allow read: if request.auth != null;
      match /rilevazioni/{rilevazioneId} {
        allow read: if request.auth != null;
      }
      match /riepilogoOre/{rilevazioneId} {
        allow read: if request.auth != null;
      }
    }
    match /osservazioniManuali/{doc} {
      allow read, write: if request.auth != null;
    }
    match /stazioneLocale/{doc} {
      allow read: if request.auth != null;
    }
    match /stazioniPubblicheNetatmo/{data} {
      allow read: if request.auth != null;
      match /rilevazioni/{rilevazioneId} {
        allow read: if request.auth != null;
      }
    }
    match /calibrazioneMeteo/{doc} {
      allow read: if request.auth != null;
    }
    match /statisticheStoriche/{doc} {
      allow read: if request.auth != null;
    }
    match /statoRadar/{doc} {
      allow read: if request.auth != null;
    }
    match /statoSistema/{doc} {
      allow read: if request.auth != null;
    }
    match /richiesteLidi/{doc} {
      allow read, write: if request.auth != null;
    }
    match /destinatariLidi/{doc} {
      allow read: if request.auth != null;
    }
    match /grigliaAdriatico/{doc} {
      allow read: if request.auth != null;
    }
    match /meteoCroazia/{doc} {
      allow read: if request.auth != null;
    }
    match /previsioneEnsemble/{doc} {
      allow read: if request.auth != null;
    }
  }
}
